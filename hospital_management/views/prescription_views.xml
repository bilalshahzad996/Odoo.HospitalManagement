<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_prescription_form" model="ir.ui.view">
        <field name="name">hospital.prescription.form</field>
        <field name="model">hospital.prescription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_print_prescription" type="object"
                            string="🖨 Print Prescription"
                            invisible="state == 'draft'" class="btn-success"/>
                    <button name="action_upload_portal" type="object"
                            string="📤 Upload to Portal"
                            invisible="state != 'confirmed'" class="btn-info"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,uploaded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Prescription Info">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_id"
                                   domain="[('patient_id', '=', patient_id)]"/>
                            <field name="date"/>
                        </group>
                        <group string="Upload PDF">
                            <field name="pdf_file" filename="pdf_filename" widget="binary"/>
                            <field name="pdf_filename" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Medicines">
                            <field name="prescription_line_ids">
                                <list editable="bottom">
                                    <field name="medicine_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Doctor Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_prescription_list" model="ir.ui.view">
        <field name="name">hospital.prescription.list</field>
        <field name="model">hospital.prescription</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'uploaded'"
                  decoration-warning="state == 'confirmed'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'uploaded'"
                       decoration-warning="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">hospital.prescription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>