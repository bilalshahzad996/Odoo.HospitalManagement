<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_attendance_form" model="ir.ui.view">
        <field name="name">dental.attendance.form</field>
        <field name="model">dental.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="staff_id"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                        <group>
                            <field name="worked_hours" widget="float_time" readonly="1"/>
                            <field name="hr_attendance_id" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_attendance_list" model="ir.ui.view">
        <field name="name">dental.attendance.list</field>
        <field name="model">dental.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="staff_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_dental_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">dental.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
