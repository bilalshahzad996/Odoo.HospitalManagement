<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_form" model="ir.ui.view">
        <field name="name">dental.appointment.form</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"          type="object" string="Confirm"          class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_in_progress"      type="object" string="Start"            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_create_treatment" type="object" string="Create Treatment" class="btn-success" invisible="state not in ['confirmed','in_progress']"/>
                    <button name="action_done"             type="object" string="Mark Done"        invisible="state in ['done','cancelled','no_show']"/>
                    <button name="action_no_show"          type="object" string="No Show"          invisible="state in ['done','cancelled','no_show']"/>
                    <button name="action_cancel"           type="object" string="Cancel"           invisible="state in ['done','cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_calendar_event"
                                icon="fa-calendar" invisible="not calendar_event_id">
                            <span class="o_stat_text">Appointments App</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Appointment Details">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_date"/>
                            <field name="duration"/>
                        </group>
                        <group string="Treatment">
                            <field name="treatment_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Clinical Notes">
                        <field name="chief_complaint"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_appointment_list" model="ir.ui.view">
        <field name="name">dental.appointment.list</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="duration"/>
                <field name="chief_complaint"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_dental_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>