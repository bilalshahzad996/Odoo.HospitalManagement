<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_doctor_form" model="ir.ui.view">
        <field name="name">dental.doctor.form</field>
        <field name="model">dental.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_appointments" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_employee" icon="fa-user"
                                invisible="not employee_id">
                            <span class="o_stat_text">HR Profile</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Doctor Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="specialization"/>
                            <field name="degree"/>
                            <field name="experience_years"/>
                            <field name="license_number"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="user_id"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_doctor_list" model="ir.ui.view">
        <field name="name">dental.doctor.list</field>
        <field name="model">dental.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization" widget="badge"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="experience_years"/>
                <field name="employee_id"/>
                <field name="appointment_count"/>
            </list>
        </field>
    </record>

    <record id="action_dental_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">dental.doctor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
