<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Inventory Item Form ── -->
    <record id="view_dental_inventory_item_form" model="ir.ui.view">
        <field name="name">dental.inventory.item.form</field>
        <field name="model">dental.inventory.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_usage" icon="fa-history">
                            <field name="usage_count" widget="statinfo" string="Usages"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_open_product" icon="fa-cube"
                                invisible="not product_id">
                            <span class="o_stat_text">View Product</span>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_stock_moves" icon="fa-exchange"
                                invisible="not product_id">
                            <span class="o_stat_text">Stock Moves</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="product_id" placeholder="Select Product"/></h1>
                    </div>
                    <group>
                        <group string="Item Details">
                            <field name="category"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="location_id"/>
                            <field name="min_quantity"/>
                        </group>
                        <group string="Live Stock (from Odoo Inventory)">
                            <field name="quantity_on_hand" readonly="1"/>
                            <field name="quantity_available" readonly="1"/>
                            <field name="is_low_stock" widget="boolean" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Storage instructions, expiry info, handling notes..."/>
                    </group>
                    <notebook>
                        <page string="Usage History" name="usage">
                            <field name="usage_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="used_by"/>
                                    <field name="doctor_id"/>
                                    <field name="patient_id"/>
                                    <field name="treatment_id"/>
                                    <field name="purpose"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Inventory Item List ── -->
    <record id="view_dental_inventory_item_list" model="ir.ui.view">
        <field name="name">dental.inventory.item.list</field>
        <field name="model">dental.inventory.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="category" widget="badge"/>
                <field name="quantity_on_hand"/>
                <field name="quantity_available"/>
                <field name="min_quantity"/>
                <field name="uom_id"/>
                <field name="location_id" optional="show"/>
                <field name="usage_count"/>
            </list>
        </field>
    </record>

    <!-- ── Usage Form ── -->
    <record id="view_dental_inventory_usage_form" model="ir.ui.view">
        <field name="name">dental.inventory.usage.form</field>
        <field name="model">dental.inventory.usage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Usage Info">
                            <field name="item_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="date"/>
                            <field name="quantity"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Used By">
                            <field name="used_by"/>
                            <field name="doctor_id"/>
                            <field name="patient_id"/>
                            <field name="treatment_id"/>
                        </group>
                    </group>
                    <group string="Odoo Inventory Link">
                        <field name="stock_move_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Usage List ── -->
    <record id="view_dental_inventory_usage_list" model="ir.ui.view">
        <field name="name">dental.inventory.usage.list</field>
        <field name="model">dental.inventory.usage</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="item_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="used_by"/>
                <field name="doctor_id"/>
                <field name="patient_id"/>
                <field name="purpose"/>
            </list>
        </field>
    </record>

    <!-- ── Actions ── -->
    <record id="action_dental_inventory" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">dental.inventory.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dental_inventory_usage" model="ir.actions.act_window">
        <field name="name">Usage Log</field>
        <field name="res_model">dental.inventory.usage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
