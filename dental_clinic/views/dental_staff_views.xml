<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_staff_form" model="ir.ui.view">
        <field name="name">dental.staff.form</field>
        <field name="model">dental.staff</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_attendance" icon="fa-clock-o">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_employee" icon="fa-user"
                                invisible="not employee_id">
                            <span class="o_stat_text">HR Profile</span>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Staff Name"/></h1>
                        <field name="staff_ref" readonly="1"/>
                    </div>
                    <group>
                        <group string="Staff Info">
                            <field name="role"/>
                            <field name="job_title"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Contact">
                            <field name="work_phone" widget="phone"/>
                            <field name="work_email" widget="email"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <div class="o_row mt16">
                        <button name="action_check_in"  type="object" string="Check In"  class="btn btn-success me-2"/>
                        <button name="action_check_out" type="object" string="Check Out" class="btn btn-warning"/>
                    </div>
                    <notebook>
                        <page string="Attendance" name="attendance">
                            <field name="attendance_ids">
                                <list>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="worked_hours" widget="float_time"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_staff_list" model="ir.ui.view">
        <field name="name">dental.staff.list</field>
        <field name="model">dental.staff</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="role" widget="badge"/>
                <field name="job_title"/>
                <field name="work_phone"/>
                <field name="work_email"/>
                <field name="attendance_count"/>
            </list>
        </field>
    </record>

    <record id="action_dental_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">dental.staff</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
