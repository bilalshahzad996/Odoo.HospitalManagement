<odoo>
    <record id="view_hospital_shift_form" model="ir.ui.view">
        <field name="name">hospital.shift.form</field>
        <field name="model">hospital.shift</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Shift Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shift_type"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hospital_shift_list" model="ir.ui.view">
        <field name="name">hospital.shift.list</field>
        <field name="model">hospital.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shift_type"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
            </list>
        </field>
    </record>
    <record id="action_hospital_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">hospital.shift</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>