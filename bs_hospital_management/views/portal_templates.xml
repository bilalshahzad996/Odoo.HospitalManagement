<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Counter -->
    <template id="portal_my_home_prescription" name="Portal My Home: Prescriptions"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Prescriptions</t>
                <t t-set="url">/my/prescriptions</t>
                <t t-set="count" t-value="prescription_count"/>
            </t>
        </xpath>
    </template>

    <!-- Prescriptions List Page -->
    <template id="portal_prescriptions" name="My Prescriptions">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2>My Prescriptions</h2>
                <table class="table table-bordered mt-3">
                    <thead class="table-dark">
                        <tr>
                            <th>Reference</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="prescriptions" t-as="p">
                            <tr>
                                <td><t t-esc="p.name"/></td>
                                <td><t t-esc="p.doctor_id.name"/></td>
                                <td><t t-esc="p.date"/></td>
                                <td>
                                    <a t-attf-href="/my/prescriptions/#{p.id}"
                                       class="btn btn-sm btn-primary">View</a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- Prescription Detail Page -->
    <template id="portal_prescription_detail" name="Prescription Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <h2>Prescription: <t t-esc="prescription.name"/></h2>
                <div class="row mt-3">
                    <div class="col-6">
                        <strong>Patient:</strong> <t t-esc="prescription.patient_id.name"/>
                    </div>
                    <div class="col-6">
                        <strong>Doctor:</strong> <t t-esc="prescription.doctor_id.name"/>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <strong>Date:</strong> <t t-esc="prescription.date"/>
                    </div>
                </div>

                <h4 class="mt-4">Medicines</h4>
                <table class="table table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Medicine</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="prescription.prescription_line_ids" t-as="line">
                            <tr>
                                <td><t t-esc="line.medicine_name"/></td>
                                <td><t t-esc="line.dosage"/></td>
                                <td><t t-esc="line.frequency"/></td>
                                <td><t t-esc="line.duration"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Download PDF if uploaded -->
                <t t-if="prescription.pdf_file">
                    <a t-attf-href="/web/content/hospital.prescription/#{prescription.id}/pdf_file/#{prescription.pdf_filename}?download=true"
                       class="btn btn-success mt-3">
                        ⬇ Download Prescription PDF
                    </a>
                </t>
            </div>
        </t>
    </template>
</odoo>