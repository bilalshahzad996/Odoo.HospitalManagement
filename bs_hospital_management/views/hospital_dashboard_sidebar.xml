<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sidebar Groups -->
    <record id="spreadsheet_dashboard_group_hospital" model="spreadsheet.dashboard.group">
        <field name="name">Hospital</field>
        <field name="sequence">100</field>
    </record>

    <record id="spreadsheet_dashboard_group_operations" model="spreadsheet.dashboard.group">
        <field name="name">Operations</field>
        <field name="sequence">200</field>
    </record>

    <!-- Dashboards under Hospital group -->
    <record id="hospital_patient_dashboard" model="spreadsheet.dashboard">
        <field name="name">Patients Overview</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_hospital"/>
        <field name="action_id" ref="action_hospital_patient_dashboard"/>
        <field name="is_published">True</field>
    </record>

    <record id="hospital_appointment_dashboard" model="spreadsheet.dashboard">
        <field name="name">Appointments Overview</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_hospital"/>
        <field name="action_id" ref="action_hospital_appointment_dashboard"/>
        <field name="is_published">True</field>
    </record>

    <record id="hospital_attendance_dashboard" model="spreadsheet.dashboard">
        <field name="name">Attendance Overview</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_hospital"/>
        <field name="action_id" ref="action_hospital_attendance_dashboard"/>
        <field name="is_published">True</field>
    </record>

    <!-- Dashboards under Operations group -->
    <record id="hospital_billing_dashboard" model="spreadsheet.dashboard">
        <field name="name">Billing Overview</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_operations"/>
        <field name="action_id" ref="action_hospital_bill_dashboard"/>
        <field name="is_published">True</field>
    </record>

    <record id="hospital_inventory_dashboard" model="spreadsheet.dashboard">
        <field name="name">Inventory Overview</field>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_operations"/>
        <field name="action_id" ref="action_hospital_inventory_dashboard"/>
        <field name="is_published">True</field>
    </record>

</odoo>
