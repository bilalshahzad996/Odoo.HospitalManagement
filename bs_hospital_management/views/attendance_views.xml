<odoo>
    <record id="view_hospital_attendance_form" model="ir.ui.view">
        <field name="name">hospital.attendance.form</field>
        <field name="model">hospital.attendance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_in" type="object" string="Check In" invisible="check_in != False" class="btn-success"/>
                    <button name="action_check_out" type="object" string="Check Out" invisible="check_out != False" class="btn-danger"/>
                </header>
                <sheet>
                    <group>
                        <group string="Staff Info">
                            <field name="staff_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="date"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'present'"
                                   decoration-warning="status == 'late'"
                                   decoration-danger="status == 'absent'"/>
                        </group>
                        <group string="Time">
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_hospital_attendance_list" model="ir.ui.view">
        <field name="name">hospital.attendance.list</field>
        <field name="model">hospital.attendance</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'late'">
                <field name="staff_id"/>
                <field name="department_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-warning="status == 'late'"
                       decoration-danger="status == 'absent'"/>
            </list>
        </field>
    </record>
    <record id="action_hospital_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">hospital.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>