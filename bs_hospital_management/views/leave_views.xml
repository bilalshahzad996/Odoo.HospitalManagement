<odoo>
    <record id="view_hospital_leave_form" model="ir.ui.view">
        <field name="name">hospital.leave.form</field>
        <field name="model">hospital.leave</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'pending'" class="btn-success"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="state != 'pending'" class="btn-danger"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Leave Info">
                            <field name="staff_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="leave_type"/>
                        </group>
                        <group string="Dates">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="total_days" readonly="1"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_hospital_leave_list" model="ir.ui.view">
        <field name="name">hospital.leave.list</field>
        <field name="model">hospital.leave</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-warning="state == 'pending'" decoration-muted="state == 'cancelled'" decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="staff_id"/>
                <field name="department_id"/>
                <field name="leave_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_days"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'pending'" decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>
    <record id="action_hospital_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">hospital.leave</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_hospital_leave_pending" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">hospital.leave</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("state","=","pending")]</field>
    </record>
</odoo>