<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hospital_service_form" model="ir.ui.view">
        <field name="name">hospital.service.form</field>
        <field name="model">hospital.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Service Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="service_type"/>
                            <field name="price"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_service_list" model="ir.ui.view">
        <field name="name">hospital.service.list</field>
        <field name="model">hospital.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_type"/>
                <field name="price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hospital.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>