<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_hospital_patient" model="ir.sequence">
        <field name="name">Hospital Patient Sequence</field>
        <field name="code">hospital.patient</field>
        <field name="prefix">PAT/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_hospital_appointment" model="ir.sequence">
        <field name="name">Hospital Appointment Sequence</field>
        <field name="code">hospital.appointment</field>
        <field name="prefix">APT/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_hospital_prescription" model="ir.sequence">
    <field name="name">Hospital Prescription Sequence</field>
    <field name="code">hospital.prescription</field>
    <field name="prefix">RX/</field>
    <field name="padding">4</field>
    <field name="number_next">1</field>
    <field name="number_increment">1</field>
</record>

    <record id="seq_hospital_inventory" model="ir.sequence">
        <field name="name">Hospital Inventory Sequence</field>
        <field name="code">hospital.inventory</field>
        <field name="prefix">INV/</field>
        <field name="padding">4</field>
    </record>

     <record id="seq_hospital_staff" model="ir.sequence">
        <field name="name">Hospital Staff Sequence</field>
        <field name="code">hospital.staff</field>
        <field name="prefix">EMP/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_hospital_leave" model="ir.sequence">
        <field name="name">Hospital Leave Sequence</field>
        <field name="code">hospital.leave</field>
        <field name="prefix">LVE/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_hospital_bill" model="ir.sequence">
        <field name="name">Hospital Bill Sequence</field>
        <field name="code">hospital.bill</field>
        <field name="prefix">BILL/</field>
        <field name="padding">4</field>
    </record>
</odoo>
