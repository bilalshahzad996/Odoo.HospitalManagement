<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bill_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:11px; line-height:1.3;">

                        <!-- Header -->
                        <div class="row mb-2">
                            <div class="col-6">
                                <h4 style="margin:0;">Hospital Management</h4>
                                <small>Medical Receipt / Bill</small>
                            </div>
                            <div class="col-6 text-end" style="font-size:10px;">
                                <strong>Bill:</strong> <t t-esc="doc.name"/><br/>
                                <strong>Date:</strong> <t t-esc="doc.bill_date"/><br/>
                                <strong>Status:</strong> <t t-esc="doc.state"/><br/>
                                <t t-if="doc.sale_order_id">
                                    <strong>SO:</strong> <t t-esc="doc.sale_order_id.name"/>
                                </t>
                            </div>
                        </div>

                        <hr style="margin:4px 0;"/>

                        <!-- Patient + Doctor in 2 cols -->
                        <div class="row mb-2" style="font-size:10px;">
                            <div class="col-6">
                                <strong>Patient:</strong>
                                <t t-esc="doc.patient_id.name"/> |
                                <t t-esc="doc.patient_id.ref"/> |
                                <t t-esc="doc.patient_id.phone"/> |
                                <t t-esc="doc.patient_id.gender"/> |
                                <t t-esc="doc.patient_id.blood_group"/>
                            </div>
                            <div class="col-6">
                                <strong>Doctor:</strong>
                                <t t-esc="doc.doctor_id.name"/> |
                                <t t-esc="doc.doctor_id.specialization"/>
                                <t t-if="doc.payment_method">
                                    | <strong>Payment:</strong> <t t-esc="doc.payment_method"/>
                                </t>
                            </div>
                        </div>

                        <hr style="margin:4px 0;"/>

                        <!-- Services Table -->
                        <t t-if="doc.bill_line_ids">
                            <strong style="font-size:11px;">Services</strong>
                            <table class="table table-bordered table-sm" style="font-size:10px; margin-bottom:4px;">
                                <thead style="background:#343a40; color:white;">
                                    <tr>
                                        <th style="padding:3px;">#</th>
                                        <th style="padding:3px;">Service</th>
                                        <th style="padding:3px;">Description</th>
                                        <th style="padding:3px; text-align:center;">Qty</th>
                                        <th style="padding:3px; text-align:right;">Price</th>
                                        <th style="padding:3px; text-align:right;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.bill_line_ids" t-as="line">
                                        <tr>
                                            <td style="padding:2px;"><t t-esc="line_index + 1"/></td>
                                            <td style="padding:2px;"><t t-esc="line.service_id.name"/></td>
                                            <td style="padding:2px;"><t t-esc="line.description"/></td>
                                            <td style="padding:2px; text-align:center;"><t t-esc="line.quantity"/></td>
                                            <td style="padding:2px; text-align:right;"><t t-esc="line.unit_price"/></td>
                                            <td style="padding:2px; text-align:right;"><t t-esc="line.subtotal"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Products Table -->
                        <t t-if="doc.bill_product_ids">
                            <strong style="font-size:11px;">Products / Medicines</strong>
                            <table class="table table-bordered table-sm" style="font-size:10px; margin-bottom:4px;">
                                <thead style="background:#343a40; color:white;">
                                    <tr>
                                        <th style="padding:3px;">#</th>
                                        <th style="padding:3px;">Product</th>
                                        <th style="padding:3px;">Description</th>
                                        <th style="padding:3px; text-align:center;">Qty</th>
                                        <th style="padding:3px; text-align:right;">Price</th>
                                        <th style="padding:3px; text-align:right;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.bill_product_ids" t-as="pline">
                                        <tr>
                                            <td style="padding:2px;"><t t-esc="pline_index + 1"/></td>
                                            <td style="padding:2px;"><t t-esc="pline.product_id.name"/></td>
                                            <td style="padding:2px;"><t t-esc="pline.description"/></td>
                                            <td style="padding:2px; text-align:center;"><t t-esc="pline.quantity"/></td>
                                            <td style="padding:2px; text-align:right;"><t t-esc="pline.unit_price"/></td>
                                            <td style="padding:2px; text-align:right;"><t t-esc="pline.subtotal"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Totals + Signature side by side -->
                        <div class="row mt-2">
                            <div class="col-6" style="font-size:10px; padding-top:20px;">
                                <t t-if="doc.notes">
                                    <strong>Notes:</strong> <t t-esc="doc.notes"/><br/>
                                </t>
                                <br/>
                                <p style="margin-top:20px;">_______________________</p>
                                <p><strong>Authorized Signature</strong></p>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size:10px;">
                                    <tr>
                                        <td>Subtotal:</td>
                                        <td class="text-end"><t t-esc="doc.subtotal"/></td>
                                    </tr>
                                    <tr>
                                        <td>Discount (<t t-esc="doc.discount"/>%):</td>
                                        <td class="text-end">- <t t-esc="doc.subtotal * doc.discount / 100"/></td>
                                    </tr>
                                    <tr>
                                        <td>Tax (<t t-esc="doc.tax"/>%):</td>
                                        <td class="text-end"><t t-esc="(doc.subtotal - doc.subtotal * doc.discount / 100) * doc.tax / 100"/></td>
                                    </tr>
                                    <tr style="background:#343a40; color:white;">
                                        <td><strong>Total:</strong></td>
                                        <td class="text-end"><strong><t t-esc="doc.total_amount"/></strong></td>
                                    </tr>
                                    <tr>
                                        <td>Amount Paid:</td>
                                        <td class="text-end"><t t-esc="doc.amount_paid"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Amount Due:</strong></td>
                                        <td class="text-end"><strong><t t-esc="doc.amount_due"/></strong></td>
                                    </tr>
                                </table>
                                <p style="margin-top:10px;">_______________________</p>
                                <p style="font-size:10px;"><strong>Patient Signature</strong></p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_bill" model="ir.actions.report">
        <field name="name">Receipt</field>
        <field name="model">hospital.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_management.report_bill_template</field>
        <field name="report_file">hospital_management.report_bill_template</field>
        <field name="binding_model_id" ref="model_hospital_bill"/>
        <field name="binding_type">report</field>
    </record>
</odoo>